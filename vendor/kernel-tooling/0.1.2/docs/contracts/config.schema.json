{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kernel-tooling config",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "ci": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "default": {}
        }
      },
      "additionalProperties": true,
      "default": {}
    }
  },
  "additionalProperties": true
}
